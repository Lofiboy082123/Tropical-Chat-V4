# Tropical Control Center (TCC) - Environment Configuration
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DB_DIALECT=sqlite
DB_STORAGE=./data/tcc.sqlite
JWT_SECRET=tropical-control-center-enterprise-secure-jwt-secret-key-32chars
JWT_EXPIRES_IN=8h
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
AGENT_HEARTBEAT_INTERVAL=30
AGENT_HEARTBEAT_TIMEOUT=60
CORS_ORIGIN=http://localhost:5173
